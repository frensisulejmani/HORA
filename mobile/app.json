{
  "expo": {
    "name": "Hora",
    "slug": "hora",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./frontend/src/assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#050505"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
