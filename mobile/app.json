        "backgroundColor": "#050505"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "apiBaseUrl": "http://localhost:5000",
      "eas": {
        "projectId": "9fbdbffe-8222-412b-85c2-008a4ba008b5"
      }
    },
    "owner": "junas-organization",
    "plugins": [
      "expo-asset"
    ]
  }
}
